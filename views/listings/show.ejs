<% layout("layouts/boilerplate") %>

<div class="container mt-5">
  <h1 class="mb-4 text-center">Listing Details</h1>

  <div class="card shadow-lg mx-auto" style="max-width: 750px">
    <% if (listing.image?.url) { %>
    <img src="<%= listing.image.url %>" class="card-img-top" alt="Listing Image" />
    <% } %>

    <div class="card-body">
      <h3 class="card-title"><%= listing.title %></h3>

      <% if (listing.price) { %>
      <h5 class="text-success mb-3">
        Price: &#8377;<%= listing.price.toLocaleString("en-IN") %>/night
      </h5>
      <% } %>   
      <p class="card-text">
        <strong>Description:</strong> <%= listing.description %>
      </p>
      <p class="card-text">       
      Owner: <i><%= listing.owner ? listing.owner.username : 'Unknown' %></i>
      </p>
      <p class=" card-text text-muted">
        <strong>Location:</strong> <%= listing.location %>, <%= listing.country %>
      </p>

      <% if (currUser && currUser._id.equals(listing.owner._id)) { %>     
        <div class="d-flex justify-content-between mb-4">
          <a href="/listings/<%= listing._id %>/edit" class="btn btn-outline-primary">Edit Listing</a>
      
          <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
            <button type="submit" class="btn btn-outline-danger">Delete Listing</button>
          </form>
        </div>
      <% } %>
      

      <hr />

      <% if(currUser) { %>
      <div class="mt-4">
        <h3>Leave a Review</h3>
        <form method="POST" action="/listings/<%= listing._id %>/reviews" class="needs-validation">
          <div class="form-group">
            <label for="rating" class="form-label">Rating (1-5)</label>
            <input
              type="range"
              id="rating"
              name="review[rating]"
              min="1"
              max="5"

            />
          </div>

          <div class="form-group mt-3">
            <label for="comment">Comment</label>
            <textarea
              id="comment"
              name="review[comment]"
              class="form-control"
              rows="4"
              required
            ></textarea>
            <div class="invalid-feedback">Please add some comment.</div>
          </div>

          <button type="submit" class="btn btn-primary mt-3">Submit Review</button>
        </form>
      </div>
      <% } else { %>
        <div class="alert alert-info mt-4">Please log in to leave a review.....</div>
      <% } %>

      <% if (listing.reviews && listing.reviews.length > 0) { %>
        <hr />
        <div class="mt-5">
          <h3 class="mb-4">User Reviews</h3>
          <div class="row row-cols-1 row-cols-md-2 g-4">
            <% listing.reviews.forEach(review => { %>
              <div class="col">
                <div class="card shadow-sm h-100 border-0">
                  <div class="card-body">
                    <% if (review.author) { %>
                      <p class="text-left text-end text-muted mb-0">
                       commented by : – <i><%= review.author.username %></i>
                      </p>
                    <% } %>
                    <div class="d-flex justify-content-between align-items-center">
                      <div class="text-warning">
                        <%= '★'.repeat(review.rating) %><%= '☆'.repeat(5 - review.rating) %>
                      </div>
                      <span class="badge bg-secondary"><%= review.rating %>/5</span>
                    </div>
                    <hr />
                    <p class="card-text text-muted mb-0"><%= review.comment %> </p>

                  </div>
      
                  <% if (currUser && review.author && currUser._id.equals(review.author._id)) { %>
                    <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" class="mb-1 mx-1">
                      <button type="submit" class="btn btn-outline-danger mt-1">Delete</button>
                    </form>
                  <% } %>
                </div>
              </div>
            <% }) %>
          </div>
        </div>
      <% } else { %>
        <div class="alert alert-info mt-5">No reviews yet. Be the first to leave one!</div>
      <% } %>
      
      
    </div>
  </div>
</div>

<script src="js/script.js"></script>
